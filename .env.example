# --- Core ---
# SQLite for local dev. For production (Postgres, e.g. Neon), set a Postgres
# connection string here. The datasource provider is flipped to "postgresql" at
# deploy time by `npm run build:prod` (scripts/use-postgres.mjs) — leave the
# committed schema on sqlite for local work.
#   DATABASE_URL          → Neon POOLED string ("-pooler" host) for app queries
#   DATABASE_URL_UNPOOLED → Neon DIRECT string (no -pooler) for migrations;
#                           wired as Prisma `directUrl` by build:prod
DATABASE_URL="file:./dev.db"
# DATABASE_URL_UNPOOLED=""

# 32+ char secret used to sign session JWTs (jose). CHANGE THIS.
AUTH_SECRET="dev-only-insecure-secret-change-me-please-32chars"

# Base URL of the app (used for delivery links, etc.)
APP_URL="http://localhost:3000"

# Seed owner account (used by `npm run db:seed`)
SEED_OWNER_EMAIL="owner@taskforge.local"
SEED_OWNER_PASSWORD="changeme123"
SEED_ORG_NAME="TaskForge"

# --- Providers (dev defaults) ---
# LLM: "fake" runs a deterministic in-repo provider (no API key needed).
# Options: "groq" (free tier) | "anthropic" | "openai" | "neon" (AI Gateway).
# Set the matching key/base URL and LLM_MODEL to use your own.
LLM_PROVIDER="fake"
LLM_MODEL="fake-1"
# Groq (OpenAI-compatible, free tier). Get a key at console.groq.com.
#   LLM_PROVIDER="groq"; LLM_MODEL="llama-3.3-70b-versatile"
# GROQ_API_KEY=""
# GROQ_BASE_URL="https://api.groq.com/openai"   # override only for a gateway
# ANTHROPIC_API_KEY=""   # LLM_PROVIDER=anthropic, e.g. LLM_MODEL=claude-sonnet-5
# OPENAI_API_KEY=""      # LLM_PROVIDER=openai,    e.g. LLM_MODEL=gpt-4o
# Neon AI Gateway (OpenAI-compatible, one credential for many models). BASE_URL
# is the bare branch host; the adapter appends /v1/chat/completions. Requires AI
# Gateway to be enabled for the account in the Neon Console.
#   LLM_PROVIDER="neon"; LLM_MODEL="gpt-5-mini"
# NEON_AI_GATEWAY_BASE_URL="https://<branch>-api.ai.<region>.aws.neon.tech"
# NEON_AI_GATEWAY_TOKEN=""   # nt_live_...

# Sandbox: "local" runs commands via a dev subprocess adapter (NOT hardened).
# Later: "e2b" | "daytona" | "docker".
SANDBOX_PROVIDER="local"

# Storage: "local" writes to ./.storage. "s3" = any S3-compatible store
# (Neon Object Storage / Cloudflare R2 / Supabase Storage / AWS S3 / MinIO).
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./.storage"
# Required when STORAGE_PROVIDER=s3:
# S3_ENDPOINT="https://<branch>.storage.<region>.aws.neon.tech"  # Neon Object Storage
# S3_REGION="us-east-2"            # Neon beta region; "auto" for R2; a real region for AWS
# S3_BUCKET="taskforge-prod"       # a bucket you created (Neon: `neon buckets create`)
# S3_ACCESS_KEY_ID=""              # Neon: nak_live_...
# S3_SECRET_ACCESS_KEY=""          # Neon: nsk_live_...
# S3_FORCE_PATH_STYLE="true"       # "true" for Neon / Supabase / MinIO; omit for R2/AWS

# Queue: "db" uses the Job table + poller. Later: "redis" (BullMQ).
QUEUE_PROVIDER="db"

# --- Integrations (optional) ---
# GitHub import works anonymously for public repos. Set a token to import
# private repos and to lift the anonymous API rate limit.
# GITHUB_TOKEN=""
